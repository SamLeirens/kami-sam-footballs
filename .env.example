# Neon pooled string (-pooler host): used by the app at runtime
DATABASE_URL=postgres://user:pass@host-pooler/db?sslmode=require
# Neon direct string (no -pooler): used by migrations/seed; falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require
ADMIN_PASSWORD=pick-a-strong-password
